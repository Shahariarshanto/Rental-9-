{
  "entities": {
    "Property": {
      "title": "Property Listing",
      "description": "Details of a house/flat for rent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Bachelor", "Family", "Office"] },
        "description": { "type": "string" },
        "rent": { "type": "number" },
        "deposit": { "type": "number" },
        "utilityDetails": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "address": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "amenities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "images": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "ownerWhatsapp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "rent", "city", "area", "ownerId"]
    },
    "Favorite": {
      "title": "Favorite Listing",
      "description": "A property saved by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "propertyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "propertyId"]
    },
    "User": {
      "title": "User Profile",
      "description": "User account details and contact information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "bio": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "photoURL": { "type": "string" },
        "contactPrivacy": { "type": "string", "enum": ["Public", "Private"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Chat": {
      "title": "Conversation",
      "description": "Real-time communication between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "lastTimestamp"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "An individual message within a conversation",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" }
      },
      "required": ["senderId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/properties": {
      "schema": "Property",
      "description": "Public property listings"
    },
    "/favorites": {
      "schema": "Favorite",
      "description": "Users' bookmarked properties"
    },
    "/users": {
      "schema": "User",
      "description": "User profile information"
    },
    "/chats": {
      "schema": "Chat",
      "description": "User conversations"
    },
    "/chats/{chatId}/messages": {
      "schema": "Message",
      "description": "Individual messages in a chat"
    }
  }
}
