rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProperty(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.category in ['Bachelor', 'Family', 'Office'] &&
             data.rent is number && data.rent >= 0 &&
             data.deposit is number && data.deposit >= 0 &&
             data.city is string && data.city.size() <= 100 &&
             data.area is string && data.area.size() <= 100 &&
             data.address is string && data.address.size() <= 500 &&
             data.description is string && data.description.size() <= 3000 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() <= 150 &&
             data.ownerPhone is string && data.ownerPhone.size() <= 30 &&
             (data.ownerWhatsapp == null || data.ownerWhatsapp == "" || (data.ownerWhatsapp is string && data.ownerWhatsapp.size() <= 30)) &&
             (data.utilityDetails == null || data.utilityDetails == "" || (data.utilityDetails is string && data.utilityDetails.size() <= 1000)) &&
             data.amenities is list && data.amenities.size() <= 40 &&
             (data.images == null || (data.images is list && data.images.size() <= 20)) &&
             (data.isFeatured == null || data.isFeatured is bool);
    }

    match /properties/{propertyId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      isValidId(propertyId) && 
                      isValidProperty(request.resource.data) &&
                      request.resource.data.ownerId == request.auth.uid &&
                      request.resource.data.createdAt == request.time;

      allow update: if isOwner(resource.data.ownerId) &&
                      isValidProperty(request.resource.data) &&
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time;
      
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (favoriteId.startsWith(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow create: if isOwner(request.resource.data.userId) && 
                      request.resource.data.createdAt == request.time;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
